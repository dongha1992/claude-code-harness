{
  "$comment": "이 파일을 harness.config.json으로 복사한 뒤 프로젝트에 맞게 수정하세요. tscCommand가 \"auto\"면 tsconfig의 references 유무로 `tsc -b` / `tsc --noEmit`을 자동 선택합니다. 직접 지정하면 그 값을 쓰며, 이때는 tscDetectPattern도 맞춰야 합니다.",
  "srcDir": "src",
  "testDir": "src",
  "testRunner": "npx vitest run",
  "testClientDir": ".",
  "lintCommand": "npm run lint",
  "tscCommand": "auto",
  "lintDetectPattern": "(npm run lint|pnpm lint|yarn lint)",
  "tscDetectPattern": "tsc\\s+(--noEmit|-b|--build)",
  "testFilePatterns": [
    "{dir}/__tests__/{name}.test.ts",
    "{dir}/__tests__/{name}.test.tsx",
    "{dir}/{name}.test.ts",
    "{dir}/{name}.test.tsx"
  ],
  "sourceExtensions": [
    "ts",
    "tsx"
  ],
  "protectedPaths": [
    ".env"
  ],
  "trackDirs": [
    "src"
  ],
  "testRunnerArgs": "--reporter=verbose"
}
